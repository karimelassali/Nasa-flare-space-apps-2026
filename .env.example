# Server-side AI provider keys for /api/analyze (optional; checked in precedence order: NVIDIA -> Gemini -> OpenAI).
# Each key is sent exclusively to its own provider endpoint.
# If no key is configured, FLARE automatically falls back to deterministic non-AI evidence summaries.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Optional explicit selection: nvidia, gemini, or openai. Leave blank for key precedence.
AI_PROVIDER=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
